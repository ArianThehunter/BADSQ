# BADSQ Platform — environment template
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
#
# Both values below are safe to expose in a browser bundle: the publishable
# (anon) key carries no privileges of its own — all access is decided by
# Row-Level Security. Do NOT put a service_role / secret key in this file:
# Vite inlines every VITE_* var into the client bundle.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Storage bucket for participant audio recordings (created by migration 0003).
VITE_SUPABASE_AUDIO_BUCKET=badsq-audio
